{
  "name": "smart-agenda",
  "version": "1.0.0",
  "private": true,
  "description": "SmartAgenda - A monorepo with Next.js frontend and Express backend",
  "scripts": {
    "start": "docker-compose up --build",
    "start:dev": "docker-compose up --build",
    "stop": "docker-compose down",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "prepare": "husky",
    "generate": "pnpm -r generate",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "type-check": "pnpm -r type-check",
    "format": "pnpm -r format",
    "format:check": "pnpm -r exec prettier --check .",
    "e2e": "./run-e2e-tests.sh --open",
    "e2e:ci": "./run-e2e-tests.sh",
    "e2e:fresh": "./run-e2e-tests.sh --clean --open",
    "e2e:kill": "lsof -ti :4100 | xargs kill -9 2>/dev/null || true; lsof -ti :3100 | xargs kill -9 2>/dev/null || true; echo '✅ Ports 3100 and 4100 cleared'",
    "e2e:docker": "docker compose -f docker-compose.e2e.yml up --build --abort-on-container-exit",
    "e2e:docker:cypress": "docker compose -f docker-compose.e2e.yml --profile cypress up --build --abort-on-container-exit",
    "e2e:docker:clean": "docker compose -f docker-compose.e2e.yml down -v --remove-orphans"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "monorepo",
    "nextjs",
    "express",
    "docker"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.0.0",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  }
}
